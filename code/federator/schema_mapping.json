        "amenities": "facilities"
      }
    },
    "Kolkata": {
      "table": "kolkata",
      "fields": {
        "flat_id": "flat_id",
        "city": "city",
        "price": "price",
        "area_sqft": "sqft",
        "location": "area_name",
        "amenities": "amenities_list"
      }
    },
    "Gurgaon": {
      "table": "gurgaon",
      "fields": {
        "flat_id": "flat_id",
        "city": "city",
        "price": "price",
        "area_sqft": "sqft",
        "location": "area_name",
        "amenities": "amenities_list"
      }
    }
  }
}